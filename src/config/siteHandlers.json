{
  "sites": [
    {
      "id": "qianwen-ai-search",
      "name": "千问AI搜索",
      "url": "https://www.qianwen.com/?q={query}",
      "logoUrl": "https://img30.360buyimg.com/imgzone/jfs/t20271106/535501/22/7073/931/6abf2fa4F2289fd11/0936050050d824c7.png",
      "enabled": true,
      "supportIframe": true,
      "supportUrlQuery": true,
      "matchPatterns": [
        "qianwen.com",
        "www.qianwen.com"
      ],
      "notes": "",
      "uploadSupported": false,
      "batchFollowUpSupported": true,
      "followUpSearchHandler": {
        "steps": [
          {
            "action": "focus",
            "selectors": [
              "div[data-slate-editor='true']",
              "textarea",
              "div[contenteditable='true']"
            ],
            "timeout": 10000,
            "description": "追问：聚焦输入框"
          },
          {
            "action": "setValue",
            "selectors": [
              "div[data-slate-editor='true']",
              "textarea",
              "div[contenteditable='true']"
            ],
            "inputType": "auto",
            "description": "追问：写入问题",
            "waitAfter": 700
          },
          {
            "action": "smartSubmit",
            "selectors": [
              "div[data-slate-editor='true']",
              "textarea"
            ],
            "optional": true,
            "description": "追问：点「发送消息」",
            "submitSelectors": [
              "button[aria-label='发送消息']",
              "button[aria-label*='发送']"
            ],
            "postClickVerifyMs": 2500,
            "enterFallbackAfterClick": false
          },
          {
            "action": "sendKeys",
            "selectors": [
              "div[data-slate-editor='true']",
              "textarea"
            ],
            "keys": [
              "Enter"
            ],
            "optional": true,
            "description": "追问：回车发送（实测有效）"
          }
        ]
      },
      "supportAiSummary": true,
      "extractor": {
        "userSelector": [
          "[class*='human-message']",
          "[class*='user-message']",
          "[class*='chat-bubble-user']",
          "[class*='question-container']"
        ],
        "assistantSelector": [
          "[class*='answer-message']",
          "[class*='agent-chat__answer']",
          "[class*='ai-message']",
          "[class*='assistant-message']"
        ],
        "aiTextSelectors": [
          "[class*='markdown']",
          "[class*='answer-text']",
          "[class*='content']"
        ]
      },
      "pageTextExtractor": {
        "tongyi.aliyun.com": {
          "containers": [
            "[class*='answer-message']",
            "[class*='agent-chat__answer']",
            "[class*='chat-bubble']"
          ],
          "content": [
            "[class*='markdown']",
            "[class*='answer-text']",
            "[class*='content']"
          ]
        },
        "qianwen.com": {
          "containers": [
            "[class*='answer-message']",
            "[class*='ai-message']",
            "[class*='assistant-message']"
          ],
          "content": [
            "[class*='markdown']",
            "[class*='answer-text']",
            "[class*='content']"
          ]
        }
      },
      "stopButtonSelectors": [
        "button[aria-label='停止回答']",
        "button[aria-label*='Stop']",
        "button[aria-label*='停止']",
        "button[data-testid*='stop']",
        "button[title*='停止']"
      ]
    },
    {
      "id": "nami-ai-search",
      "name": "纳米AI搜索",
      "url": "https://so.n.cn/?q={query}",
      "enabled": true,
      "supportIframe": true,
