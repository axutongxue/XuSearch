        "steps": [
          {
            "action": "focus",
            "selectors": [
              "textarea.composition-input",
              "textarea[placeholder*='提出后续问题']"
            ],
            "timeout": 25000,
            "description": "追问：聚焦追问框（该站挂载较晚）"
          },
          {
            "action": "setValue",
            "selectors": [
              "textarea.composition-input",
              "textarea[placeholder*='提出后续问题']"
            ],
            "inputType": "auto",
            "maxAttempts": 20,
            "stableWaitMs": 600,
            "description": "追问：写入问题",
            "waitAfter": 700
          },
          {
            "action": "sendKeys",
            "selectors": [
              "textarea.composition-input",
              "textarea[placeholder*='提出后续问题']"
            ],
            "keys": [
              "Enter"
            ],
            "description": "追问：回车发送（追问框自述「Enter发送」）"
          }
        ]
      },
      "supportAiSummary": true,
      "stopButtonSelectors": [
        "[class*='message-progress-box']",
        "[class*='message-progress']"
      ],
      "extractor": {
        "userSelector": [
          "#message-prompt"
        ],
        "assistantSelector": [
          ".js-article-content"
        ]
      },
      "pageTextExtractor": {
        "so.n.cn": {
          "containers": [
            ".js-article-content"
          ]
        }
      }
    },
